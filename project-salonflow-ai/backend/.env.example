# Copiez ce fichier en .env et remplacez les valeurs.
# Port de l'API.
PORT=4000
# Code PIN de l'espace professionnel (démo uniquement, pas une vraie sécurité). 1234 si absent.
PRO_PIN=changez-moi
# Origine du frontend autorisée à appeler l'API (plusieurs : séparées par des virgules).
CORS_ORIGIN=http://localhost:3000
